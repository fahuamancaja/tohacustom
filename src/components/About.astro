---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';

const highlights = (await getCollection('highlights')).sort((a, b) => a.data.order - b.data.order);
---

<section id="about" class="section border-t border-slate-200 dark:border-slate-800">
  <div class="container-page grid gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <SectionHeading eyebrow="About" title="Cloud, AI and the integrations in between." />
      <div class="space-y-4 text-base leading-relaxed text-slate-600 dark:text-slate-400">
        {site.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <dl class="mt-8 grid grid-cols-2 gap-4 text-sm">
        <div class="card px-4 py-3">
          <dt class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Based in</dt>
          <dd class="mt-1 font-semibold text-slate-900 dark:text-white">{site.location}</dd>
        </div>
        <div class="card px-4 py-3">
          <dt class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Currently</dt>
          <dd class="mt-1 font-semibold text-slate-900 dark:text-white">{site.role}, {site.company.name}</dd>
        </div>
      </dl>
    </div>

    <div>
      <p class="eyebrow mb-4">What I do now</p>
      <ul class="space-y-3">
        {highlights.map(({ data }) => (
          <li class="card flex gap-4 p-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-accent-50 text-accent-600 dark:bg-accent-500/10 dark:text-accent-300">
              <Icon name={data.icon} size={20} />
            </span>
            <div>
              <h3 class="text-base font-semibold">{data.title}</h3>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{data.summary}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
