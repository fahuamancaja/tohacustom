---
import Icon from './Icon.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-950">
  <div class="container-page flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-semibold text-slate-900 dark:text-white">{site.name}</p>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">© {year} · {site.tagline}</p>
    </div>
    <div class="flex items-center gap-2">
      <a href={`mailto:${site.email}`} class="nav-link inline-flex items-center gap-2"><Icon name="mail" size={16} /> Email</a>
      <a href={site.links.linkedin} target="_blank" rel="noopener" class="nav-link inline-flex items-center gap-2"><Icon name="linkedin" size={16} /> LinkedIn</a>
      <a href={site.links.github} target="_blank" rel="noopener" class="nav-link inline-flex items-center gap-2"><Icon name="github" size={16} /> GitHub</a>
    </div>
  </div>
  <div class="border-t border-slate-200 dark:border-slate-800">
    <div class="container-page flex flex-col gap-2 py-4 text-xs text-slate-500 sm:flex-row sm:justify-between dark:text-slate-500">
      <p>Built with <a href="https://astro.build" class="underline-offset-2 hover:underline" target="_blank" rel="noopener">Astro</a> and <a href="https://tailwindcss.com" class="underline-offset-2 hover:underline" target="_blank" rel="noopener">Tailwind CSS</a>. Hosted on Netlify.</p>
      <p><a href={site.links.source} class="underline-offset-2 hover:underline" target="_blank" rel="noopener">View source on GitHub</a></p>
    </div>
  </div>
</footer>
