---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import avatar from '../assets/avatar.png';
import { site } from '../data/site';
---

<section id="top" class="relative overflow-hidden">
  <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[32rem] w-[48rem] -translate-x-1/2 rounded-full bg-linear-to-br from-accent-400/30 via-indigo-400/20 to-transparent blur-3xl dark:from-accent-500/20 dark:via-indigo-500/10" aria-hidden="true"></div>

  <div class="container-page grid items-center gap-12 py-20 sm:py-24 lg:grid-cols-[1.15fr_0.85fr] lg:py-32">
    <div>
      <p class="chip-accent gap-2">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        {site.role} · <a href={site.company.url} target="_blank" rel="noopener" class="underline-offset-2 hover:underline">{site.company.name}</a>
      </p>
      <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
        Hi, I'm {site.nickname}.
        <span class="mt-2 block bg-linear-to-r from-accent-600 via-indigo-500 to-violet-500 bg-clip-text text-transparent dark:from-accent-400 dark:via-indigo-400 dark:to-violet-400">{site.headline}</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        {site.name}. I design Azure infrastructure in Terraform, orchestrate AI agents with Semantic Kernel on Azure AI Foundry, and ship the .NET APIs and event-driven integrations that connect them to real systems.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={site.links.linkedin} target="_blank" rel="noopener" class="btn-primary"><Icon name="linkedin" size={16} /> LinkedIn</a>
        <a href={site.links.github} target="_blank" rel="noopener" class="btn-secondary"><Icon name="github" size={16} /> GitHub</a>
        <a href="#contact" class="btn-secondary"><Icon name="mail" size={16} /> Get in touch</a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-2" aria-label="Core stack">
        {site.heroChips.map((chip) => <li class="chip">{chip}</li>)}
      </ul>
    </div>

    <div class="relative mx-auto w-64 sm:w-72 lg:w-80">
      <div class="absolute -inset-3 rounded-full bg-linear-to-br from-accent-500 via-indigo-500 to-violet-500 opacity-80 blur-lg dark:opacity-60" aria-hidden="true"></div>
      <div class="animate-float relative rounded-full bg-linear-to-br from-accent-500 via-indigo-500 to-violet-500 p-1">
        <Image
          src={avatar}
          alt={`Portrait of ${site.name}`}
          width={320}
          height={320}
          widths={[256, 320, 640]}
          sizes="(min-width: 1024px) 320px, (min-width: 640px) 288px, 256px"
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full rounded-full bg-white object-cover dark:bg-slate-900"
        />
      </div>
      <div class="absolute -bottom-3 -left-4 card flex items-center gap-2 px-3 py-2 text-xs font-semibold text-slate-700 dark:text-slate-200">
        <img src="/images/skills/azure.svg" alt="" width="20" height="20" class="logo" />
        Azure
      </div>
      <div class="absolute -top-2 -right-6 card flex items-center gap-2 px-3 py-2 text-xs font-semibold text-slate-700 dark:text-slate-200">
        <img src="/images/skills/semantic-kernel.svg" alt="" width="20" height="20" class="logo" />
        Semantic Kernel
      </div>
    </div>
  </div>

  <div class="container-page pb-8 text-center">
    <a href="#about" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">
      Scroll to learn more <Icon name="arrow-down" size={16} />
    </a>
  </div>
</section>
