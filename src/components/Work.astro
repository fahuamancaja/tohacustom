---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const more = projects.filter((p) => !p.data.featured);
---

<section id="work" class="section">
  <div class="container-page">
    <SectionHeading
      eyebrow="Work"
      title="Selected work."
      description="Recent client work at CapTech, described at the level of problem, approach and outcome, plus earlier side projects."
    />

    <div class="grid gap-6 lg:grid-cols-3">
      {featured.map(({ data }) => (
        <article class="card flex flex-col p-6">
          <div class="flex items-center gap-3">
            {data.logo && <img src={data.logo} alt="" width="36" height="36" class="logo h-9 w-9" loading="lazy" />}
            <div>
              <h3 class="font-semibold leading-tight">{data.name}</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400">{data.role} · {data.timeline}</p>
            </div>
          </div>
          <p class="mt-4 text-sm text-slate-600 dark:text-slate-400">{data.summary}</p>
          <dl class="mt-5 space-y-3 text-sm">
            {[
              ['Problem', data.problem],
              ['Approach', data.approach],
              ['Outcome', data.outcome],
            ].map(([label, text]) => text && (
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-400">{label}</dt>
                <dd class="mt-1 text-slate-600 dark:text-slate-400">{text}</dd>
              </div>
            ))}
          </dl>
          <ul class="mt-auto flex flex-wrap gap-1.5 pt-5">
            {data.tags.map((tag) => <li class="chip">{tag}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <h3 class="mt-16 text-lg font-semibold">More projects</h3>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {more.map(({ data }) => (
        <article class="card flex flex-col p-5">
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-3">
              {data.logo && <img src={data.logo} alt="" width="28" height="28" class="logo h-7 w-7" loading="lazy" />}
              <div>
                <h4 class="font-semibold leading-tight">{data.name}</h4>
                <p class="text-xs text-slate-500 dark:text-slate-400">{data.timeline}</p>
              </div>
            </div>
            {data.repo && (
              <a href={data.repo} target="_blank" rel="noopener" class="nav-link -mr-2 -mt-1 inline-flex" aria-label={`${data.name} on GitHub`}>
                <Icon name="github" size={16} />
              </a>
            )}
            {!data.repo && data.url && (
              <a href={data.url} target="_blank" rel="noopener" class="nav-link -mr-2 -mt-1 inline-flex" aria-label={`Open ${data.name}`}>
                <Icon name="external-link" size={16} />
              </a>
            )}
          </div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">{data.summary}</p>
          <ul class="mt-auto flex flex-wrap gap-1.5 pt-4">
            {data.tags.map((tag) => <li class="chip">{tag}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
