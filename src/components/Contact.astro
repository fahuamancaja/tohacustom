---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section id="contact" class="section bg-slate-50 dark:bg-slate-900/40">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-3xl bg-slate-900 px-6 py-14 text-center text-white sm:px-12 dark:bg-slate-900">
      <div class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-accent-500/30 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-24 left-0 h-72 w-72 rounded-full bg-indigo-500/30 blur-3xl" aria-hidden="true"></div>
      <p class="eyebrow text-accent-300">Contact</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">Let's build something on Azure.</h2>
      <p class="mx-auto mt-4 max-w-xl text-slate-300">
        Whether it is a Terraform platform, an integration that needs to stop breaking, or an AI agent you want to trust in production, I would enjoy hearing about it.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={`mailto:${site.email}`} class="btn bg-white text-slate-900 hover:bg-accent-100"><Icon name="mail" size={16} /> {site.email}</a>
        <a href={site.links.linkedin} target="_blank" rel="noopener" class="btn border border-white/30 text-white hover:bg-white/10"><Icon name="linkedin" size={16} /> LinkedIn</a>
      </div>
    </div>
  </div>
</section>
