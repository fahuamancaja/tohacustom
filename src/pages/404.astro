---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found · Fernando Huamancaja" description="That page does not exist.">
  <section class="container-page section text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">Nothing here.</h1>
    <p class="mt-4 text-slate-600 dark:text-slate-400">The page you were looking for does not exist or has moved.</p>
    <a href="/" class="btn-primary mt-8"><Icon name="arrow-right" size={16} /> Back to the homepage</a>
  </section>
</Base>
